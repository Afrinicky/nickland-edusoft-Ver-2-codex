{
  "name": "nickland-edusoft",
  "version": "2.0.0",
  "description": "Nickland Edusoft \u2014 School Management System by Nickland Sales",
  "main": "electron/main.js",
  "author": "Nickland Sales",
  "license": "Proprietary",
  "scripts": {
    "build:preload": "node scripts/build-preload.mjs",
    "predev": "npm run build:preload",
    "prebuild": "npm run build:preload",
    "prebuild:win": "npm run build:preload",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && npm run build:desk && npm run harden && electron-builder && npm run harden:restore",
    "build:win": "npm run build:renderer && npm run build:desk && npm run harden && electron-builder --win && npm run harden:restore",
    "harden": "node scripts/harden.mjs",
    "harden:check": "node scripts/harden.mjs --check",
    "harden:restore": "git checkout -- electron/licence/index.js electron/licence/sentinel.js electron/licence/integrity.js 2>/dev/null || true",
    "build:web": "node scripts/build-web.mjs",
    "serve:web": "node scripts/serve-web.mjs",
    "build:desk": "node scripts/build-desk.mjs",
    "serve:desk": "node scripts/serve-desk.mjs",
    "host": "node host/server.js",
    "host:provision": "node host/provision.js",
    "host:create-admin": "node host/create-admin.js",
    "host:backup": "node host/backup.js",
    "add-school": "node scripts/add-school.mjs",
    "dev:desk": "vite --config vite.desk.config.js",
    "desk:coverage": "node scripts/desk-coverage.mjs",
    "rebuild": "electron-builder install-app-deps",
    "test": "node scripts/contrast.mjs && node scripts/run-tests.mjs --cloud",
    "test:regressions": "node scripts/run-tests.mjs",
    "test:contrast": "node scripts/contrast.mjs",
    "test:cloud": "node scripts/run-tests.mjs --cloud-only",
    "test:online": "cd cloud-python && python3 tests/run_all.py && cd .. && node scripts/desk-coverage.mjs --check",
    "pretest": "npm run build:preload",
    "pretest:regressions": "npm run build:preload",
    "test:one": "node scripts/run-tests.mjs --only"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "bcryptjs": "^2.4.3",
    "docx": "^9.0.2",
    "docxtemplater": "^3.50.0",
    "pizzip": "^3.1.7",
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^5.0.0",
    "dayjs": "^1.11.13",
    "uuid": "^10.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "@electron/fuses": "^1.8.0",
    "bytenode": "^1.5.7",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.nicklandsales.edusoft",
    "productName": "Nickland Edusoft",
    "copyright": "Copyright \u00a9 2026 Nickland Sales. All rights reserved.",
    "directories": {
      "output": "dist-app",
      "buildResources": "resources"
    },
    "afterPack": "scripts/fuses.mjs",
    "asar": true,
    "files": [
      "electron/**/*",
      "dist/**/*",
      "resources/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico",
      "artifactName": "Nickland-Edusoft-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nickland Edusoft"
    }
  }
}
