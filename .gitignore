# Dependencies
node_modules/

# Build outputs
dist/
dist-app/

# The preload script Electron actually loads. Generated from
# electron/preload.js + electron/api-surface.js by
# `npm run build:preload`, which every script that runs or packages
# the application does first.
electron/preload.bundle.js

# Mobile web app build, and the copies the servers serve it from. Produced by
# `npm run build:web` at the repo root; never committed.
mobile/dist-web/
resources/webapp/
cloud/webapp/
cloud-python/webapp/

# The office application's browser build, and the copies the servers serve it
# from. Produced by `npm run build:desk` at the repo root; never committed.
dist-desk/
resources/desk/
cloud/desk/
cloud-python/desk/

# The web host's own scratch directory, when it is run locally without
# EDUSOFT_DATA_DIR set. On Render this is a mounted disk, not this.
.host-data/

# Electron-builder cache (created during CI builds)
.cache/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Lock files — yarn.lock not used, npm lock IS committed for reproducible CI builds
yarn.lock

# User data (should never be in repo)
*.db
*.db-shm
*.db-wal

# Temporary
*.tmp
.tmp/
