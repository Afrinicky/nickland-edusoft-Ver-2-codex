{
  "name": "nickland-edusoft-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Nickland Edusoft mobile client — parents, teachers & staff. Connects to a school's desktop host (LAN) or the cloud portal.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",

    "prebuild": "expo prebuild --platform android --clean",
    "bundle:check": "expo export --platform android --output-dir .expo/export-check",
    "doctor": "expo-doctor",

    "build:apk": "eas build --platform android --profile apk",
    "build:preview": "eas build --platform android --profile preview",
    "build:play": "eas build --platform android --profile production",
    "build:apk:local": "eas build --platform android --profile apk --local",

    "apk:gradle": "expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease && echo APK: android/app/build/outputs/apk/release/app-release.apk"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-build-properties": "~0.12.5",
    "expo-constants": "~16.0.0",
    "expo-linking": "~6.3.0",
    "expo-router": "~3.5.0",
    "expo-secure-store": "~13.0.0",
    "expo-status-bar": "~1.12.0",
    "expo-system-ui": "~3.0.7",
    "expo-web-browser": "~13.0.3",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0"
  }
}
