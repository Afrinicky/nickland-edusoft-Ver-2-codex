{
  "expo": {
    "name": "Nickland Edusoft",
    "slug": "nickland-edusoft-mobile",
    "scheme": "nicklandedusoft",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1B3A6B"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.nicklandsales.edusoft" },
    "android": {
      "package": "com.nicklandsales.edusoft",
      "adaptiveIcon": { "backgroundColor": "#1B3A6B" },
      "usesCleartextTraffic": true
    },
    "web": { "bundler": "metro", "output": "static" },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": false }
  }
}
